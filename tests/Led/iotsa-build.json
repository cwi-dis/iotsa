{
  "source": "examples/Led",
  "defaults": {
    "ci": {
      "platformio": true,
      "arduino": false
    }
  },
  "variants": [
    {
      "board": "vanilla_esp8266",
      "label": "all",
      "_note": "BLE is ESP32-only (NimBLE isn't available for esp8266) -- omit IOTSA_WITH_BLE here.",
      "build_flags": [
        "-DIOTSA_WITH_COAP",
        "-DIOTSA_WITH_HTTPS"
      ]
    },
    {
      "board": "vanilla_esp32",
      "label": "all",
      "build_flags": [
        "-DIOTSA_WITH_BLE",
        "-DIOTSA_WITH_COAP",
        "-DIOTSA_WITH_HTTPS"
      ],
      "ci": {
        "platformio": true,
        "arduino": true
      }
    },
    {
      "board": "vanilla_esp32c3",
      "label": "all",
      "build_flags": [
        "-DIOTSA_WITH_BLE",
        "-DIOTSA_WITH_COAP",
        "-DIOTSA_WITH_HTTPS"
      ]
    },
    {
      "board": "vanilla_esp32s3",
      "label": "all",
      "build_flags": [
        "-DIOTSA_WITH_BLE",
        "-DIOTSA_WITH_COAP",
        "-DIOTSA_WITH_HTTPS"
      ],
      "ci": {
        "platformio": true,
        "arduino": true
      }
    },
    {
      "board": "vanilla_esp8266",
      "label": "onlycoap",
      "build_flags": [
        "-DIOTSA_WITH_COAP",
        "-DIOTSA_WITHOUT_WEB",
        "-DIOTSA_WITHOUT_REST",
        "-DIOTSA_WITHOUT_HTTP",
        "-DIOTSA_WITHOUT_HTTPS"
      ]
    },
    {
      "board": "vanilla_esp32",
      "label": "onlycoap",
      "build_flags": [
        "-DIOTSA_WITH_COAP",
        "-DIOTSA_WITHOUT_WEB",
        "-DIOTSA_WITHOUT_REST",
        "-DIOTSA_WITHOUT_HTTP",
        "-DIOTSA_WITHOUT_HTTPS"
      ]
    },
    {
      "board": "vanilla_esp8266",
      "label": "onlyhttps",
      "build_flags": [
        "-DIOTSA_WITHOUT_HTTP",
        "-DIOTSA_WITH_HTTPS"
      ]
    },
    {
      "board": "vanilla_esp32",
      "label": "onlyhttps",
      "build_flags": [
        "-DIOTSA_WITHOUT_HTTP",
        "-DIOTSA_WITH_HTTPS"
      ]
    },
    {
      "board": "vanilla_esp32s3",
      "label": "onlyble",
      "build_flags": [
        "-DIOTSA_WITH_BLE",
        "-DIOTSA_WITHOUT_WIFI",
        "-DIOTSA_WITHOUT_HTTP",
        "-DIOTSA_WITHOUT_WEB",
        "-DIOTSA_WITHOUT_REST",
        "-DIOTSA_WITHOUT_COAP"
      ]
    },
    {
      "board": "vanilla_esp8266",
      "label": "nonetworking",
      "build_flags": [
        "-DIOTSA_WITHOUT_WIFI",
        "-DIOTSA_WITHOUT_HTTP",
        "-DIOTSA_WITHOUT_HTTPS",
        "-DIOTSA_WITHOUT_WEB",
        "-DIOTSA_WITHOUT_REST",
        "-DIOTSA_WITHOUT_COAP",
        "-DIOTSA_STARTUP_BLINK_COUNT=10"
      ]
    },
    {
      "board": "vanilla_esp32",
      "label": "nonetworking",
      "_partitions_note": "Deliberately on default.csv, the stock Arduino-IDE layout: since #245 every 4MB ESP32 board defaults to min_spiffs.csv, so this is the only remaining build coverage of default.csv. Fits easily: -DIOTSA_WITHOUT_WIFI leaves a tiny app.",
      "partitions": "default.csv",
      "build_flags": [
        "-DIOTSA_WITHOUT_WIFI",
        "-DIOTSA_WITHOUT_HTTP",
        "-DIOTSA_WITHOUT_HTTPS",
        "-DIOTSA_WITHOUT_WEB",
        "-DIOTSA_WITHOUT_REST",
        "-DIOTSA_WITHOUT_COAP",
        "-DIOTSA_STARTUP_BLINK_COUNT=10"
      ]
    }
  ]
}
