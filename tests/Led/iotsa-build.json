{
  "source": "examples/Led",
  "defaults": {
    "ci": {
      "platformio": true,
      "arduino": false
    }
  },
  "variants": [
    {
      "board": "vanilla_esp8266",
      "label": "all",
      "_note": "BLE is ESP32-only (NimBLE isn't available for esp8266) -- omit IOTSA_WITH_BLE here.",
      "build_flags": [
        "-DIOTSA_WITH_COAP",
        "-DIOTSA_WITH_HTTPS"
      ]
    },
    {
      "board": "vanilla_esp32",
      "label": "all",
      "build_flags": [
        "-DIOTSA_WITH_BLE",
        "-DIOTSA_WITH_COAP",
        "-DIOTSA_WITH_HTTPS"
      ],
      "partitions": "min_spiffs.csv",
      "ci": {
        "platformio": true,
        "arduino": true
      }
    },
    {
      "board": "vanilla_esp32c3",
      "label": "all",
      "build_flags": [
        "-DIOTSA_WITH_BLE",
        "-DIOTSA_WITH_COAP",
        "-DIOTSA_WITH_HTTPS"
      ],
      "partitions": "min_spiffs.csv"
    },
    {
      "board": "vanilla_esp32s3",
      "label": "all",
      "build_flags": [
        "-DIOTSA_WITH_BLE",
        "-DIOTSA_WITH_COAP",
        "-DIOTSA_WITH_HTTPS"
      ],
      "partitions": "min_spiffs.csv",
      "ci": {
        "platformio": true,
        "arduino": true
      }
    },
    {
      "board": "vanilla_esp8266",
      "label": "onlycoap",
      "build_flags": [
        "-DIOTSA_WITH_COAP",
        "-DIOTSA_WITHOUT_WEB",
        "-DIOTSA_WITHOUT_REST",
        "-DIOTSA_WITHOUT_HTTP",
        "-DIOTSA_WITHOUT_HTTPS"
      ]
    },
    {
      "board": "vanilla_esp32",
      "label": "onlycoap",
      "build_flags": [
        "-DIOTSA_WITH_COAP",
        "-DIOTSA_WITHOUT_WEB",
        "-DIOTSA_WITHOUT_REST",
        "-DIOTSA_WITHOUT_HTTP",
        "-DIOTSA_WITHOUT_HTTPS"
      ],
      "partitions": "min_spiffs.csv"
    },
    {
      "board": "vanilla_esp8266",
      "label": "onlyhttps",
      "build_flags": [
        "-DIOTSA_WITHOUT_HTTP",
        "-DIOTSA_WITH_HTTPS"
      ]
    },
    {
      "board": "vanilla_esp32",
      "label": "onlyhttps",
      "build_flags": [
        "-DIOTSA_WITHOUT_HTTP",
        "-DIOTSA_WITH_HTTPS"
      ],
      "partitions": "min_spiffs.csv"
    },
    {
      "board": "vanilla_esp32s3",
      "label": "onlyble",
      "build_flags": [
        "-DIOTSA_WITH_BLE",
        "-DIOTSA_WITHOUT_WIFI",
        "-DIOTSA_WITHOUT_HTTP",
        "-DIOTSA_WITHOUT_WEB",
        "-DIOTSA_WITHOUT_REST",
        "-DIOTSA_WITHOUT_COAP"
      ]
    },
    {
      "board": "vanilla_esp8266",
      "label": "nonetworking",
      "_partitions_note": "null overrides the file default deliberately: -DIOTSA_WITHOUT_WIFI makes OTA unreachable in this build regardless of partition scheme, so there's nothing for min_spiffs.csv to protect here -- see iotsa#40.",
      "partitions": null,
      "build_flags": [
        "-DIOTSA_WITHOUT_WIFI",
        "-DIOTSA_WITHOUT_HTTP",
        "-DIOTSA_WITHOUT_HTTPS",
        "-DIOTSA_WITHOUT_WEB",
        "-DIOTSA_WITHOUT_API",
        "-DIOTSA_WITHOUT_REST",
        "-DIOTSA_WITHOUT_COAP",
        "-DIOTSA_STARTUP_BLINK_COUNT=10"
      ]
    },
    {
      "board": "vanilla_esp32",
      "label": "nonetworking",
      "_partitions_note": "null overrides the file default deliberately: -DIOTSA_WITHOUT_WIFI makes OTA unreachable in this build regardless of partition scheme, so there's nothing for min_spiffs.csv to protect here -- see iotsa#40.",
      "partitions": null,
      "build_flags": [
        "-DIOTSA_WITHOUT_WIFI",
        "-DIOTSA_WITHOUT_HTTP",
        "-DIOTSA_WITHOUT_HTTPS",
        "-DIOTSA_WITHOUT_WEB",
        "-DIOTSA_WITHOUT_API",
        "-DIOTSA_WITHOUT_REST",
        "-DIOTSA_WITHOUT_COAP",
        "-DIOTSA_STARTUP_BLINK_COUNT=10"
      ]
    }
  ]
}
