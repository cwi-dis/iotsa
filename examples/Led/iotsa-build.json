{
  "_note": "BLE is ESP32-only (NimBLE isn't available for esp8266): the esp8266 variant builds without the BLE service.",
  "variants": [
    {
      "board": "vanilla_esp8266",
      "ci": {
        "platformio": true,
        "arduino": true
      }
    },
    {
      "board": "vanilla_esp32",
      "build_flags": [
        "-DIOTSA_WITH_BLE"
      ],
      "ci": {
        "platformio": true,
        "arduino": true
      }
    },
    {
      "board": "vanilla_esp32c3",
      "build_flags": [
        "-DIOTSA_WITH_BLE"
      ],
      "ci": {
        "platformio": true,
        "arduino": false
      }
    },
    {
      "board": "vanilla_esp32s3",
      "build_flags": [
        "-DIOTSA_WITH_BLE"
      ],
      "ci": {
        "platformio": true,
        "arduino": true
      }
    }
  ]
}
